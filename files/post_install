main ()
{
    rm -fv /etc/apt/sources.list.d/ceph.sources /etc/apt/sources.list.d/pve-enterprise.sources

    cat > /etc/apt/sources.list.d/proxmox.sources << 'EOF'
Types: deb
URIs: http://download.proxmox.com/debian/pve
Suites: trixie
Components: pve-no-subscription
Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg
EOF

    export DEBIAN_FRONTEND=noninteractive
    export TERM=xterm
    apt-get update && apt-get -y dist-upgrade
    apt-get install -q -y vim screen tmux jq dhcpdump arping parted tree ncdu haproxy wget curl pigz ethtool snmpd unzip needrestart dhcping
    pveam update
    apt-get autoremove -y
    apt-get autoclean -y

    rc_files

    haproxy_config

    read -p "DELETE '/dev/pve/data' (y/n): " answer

    case ${answer} in
        'y'|'Y'|'[yY][eE][sS]')
            lvchange -an /dev/pve/data
            lvremove /dev/pve/data
            lvresize -l +100%FREE -r /dev/pve/root
        ;;

        *)
            echo "not deleting '/dev/pve/data'"
        ;;
    esac

    sync
}

### script begins here ###

ver=$(pveversion | cut -d/ -f2)
addr=$(ip -o -4 addr list vmbr0 | head -n1 | awk '{print $4}' | cut -d/ -f1)
haddr=$(echo $addr | tr '.' '-')
pve_name="pve-${haddr}"

echo "PVE Version [$ver]"
echo "PVE Name [$pve_name]"

echo "Waiting for some time, press CTRL+C to abort ..."
sleep 10

now=$(date +"%F-%H-%M-%S")

main $@

exit 0
